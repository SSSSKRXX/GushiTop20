# Optional LLM configuration. Do not commit real keys.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# Optional local data source overrides. The app loads this .env automatically.
# The bundled collector defaults to data\stockmonitor\spot.json, so no override
# is needed for the standard setup.
# STOCKMONITOR_SPOT_FILE=D:\MarketData\spot.json
# SECTOR_CACHE_FILE=D:\MarketData\sector_cache.json
# MARKET_CAP_CACHE_FILE=D:\MarketData\market_cap_cache.json
# RAW_INDICES_FILE=D:\MarketData\raw_indices.json
# KNOWLEDGE_DB_FILE=D:\MarketData\knowledge.db

# Optional request/cache tuning.
KS11_YAHOO_CACHE_SECONDS=900
KS11_YAHOO_TIMEOUT_SECONDS=8
TENCENT_FUND_PAGES=3
STOCKMONITOR_READ_DELAY_SECONDS=60
